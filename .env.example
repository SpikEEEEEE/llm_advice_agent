APP_ENV=development
BACKEND_API_KEY=
DATABASE_PATH=./data/ashare_advisor.db
UNIVERSE_PATH=./config/universe.yaml
CACHE_PATH=./data/cache

DECISION_EXECUTION_MODE=process
DECISION_WORKERS=1
DECISION_QUEUE_CAPACITY=10
DECISION_TASK_TIMEOUT_SECONDS=600
MAX_AS_OF_SKEW_MINUTES=10

DATA_MODE=auto
TUSHARE_TOKEN=replace-me
TUSHARE_TIMEOUT_SECONDS=20
MARKET_HISTORY_DAYS=400
NEWS_LOOKBACK_DAYS=3
NEWS_TOP_K=5

LLM_API_KEY=replace-me
# LLM_API_KEY can be used instead of OPENAI_API_KEY.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# auto uses json_object directly for api.deepseek.com and json_schema elsewhere.
LLM_STRUCTURED_OUTPUT_MODE=auto

# single_llm keeps the original one-call engine. portfolio_multi_agent runs
# pool-wide analysts, debate, portfolio construction, and risk review.
DECISION_ENGINE=portfolio_multi_agent
MULTI_AGENT_SHORTLIST_SIZE=8
MULTI_AGENT_PARALLELISM=3
MULTI_AGENT_MAX_CALLS=32
MULTI_AGENT_OUTPUT_RETRIES=1
MULTI_AGENT_SEMANTIC_RETRIES=1
MULTI_AGENT_MIN_ANALYSTS=2
MULTI_AGENT_MIN_RISK_REVIEWS=2
MULTI_AGENT_TECHNICAL_WEIGHT=0.35
MULTI_AGENT_FUNDAMENTAL_WEIGHT=0.40
MULTI_AGENT_NEWS_WEIGHT=0.25

MIN_CASH_RATIO=0.05
MAX_POSITION_RATIO=0.30
MAX_POSITIONS=10
BUY_FEE_BUFFER_RATIO=0.001
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=15
